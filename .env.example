# Required: Notion data source ID (not the database page ID).
NOTION_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: absolute path to the SQLite database. Defaults to ./credentials.db.
# DB_PATH=/absolute/path/to/notion-api-credential-manager/data/credentials.db

# Optional: allow the copy action to print secrets to stdout when pbcopy is unavailable.
# Disabled by default so secrets never leak into terminal scrollback or recordings.
# QUANTUMDATA_ALLOW_STDOUT_SECRET=1

# Optional: base64-encoded 32-byte master key for systems without a macOS Keychain.
# On macOS the app generates and stores the key in the Keychain automatically.
# Do not put a real key in this committed file.
# QUANTUMDATA_MASTER_KEY=
